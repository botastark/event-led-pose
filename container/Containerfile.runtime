FROM docker.io/library/ubuntu:24.04@sha256:52df9b1ee71626e0088f7d400d5c6b5f7bb916f8f0c82b474289a4ece6cf3faf

ARG DEBIAN_FRONTEND=noninteractive
ARG OPENEB_VERSION=5.3.0

LABEL org.opencontainers.image.title="event-led-pose OpenEB C++ runtime"
LABEL org.opencontainers.image.description="Ubuntu 24.04 C++ environment for Prophesee EVK4, OpenEB and OpenCV"
LABEL org.opencontainers.image.version="5.3.0-r3-ubuntu24"

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        software-properties-common \
    && curl --fail --show-error --silent --location \
        https://propheseeai.jfrog.io/artifactory/api/security/keypair/prophesee-gpg/public \
        --output /etc/apt/trusted.gpg.d/prophesee.asc \
    && add-apt-repository --yes \
        'https://propheseeai.jfrog.io/artifactory/openeb-debian/' \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        pkg-config \
        libopencv-dev \
        "metavision-openeb=${OPENEB_VERSION}" \
    && test "$(dpkg-query -W -f='${Version}' metavision-openeb)" = "${OPENEB_VERSION}" \
    && pkg-config --exists opencv4 \
    && pkg-config --modversion opencv4 \
    && metavision_platform_info --help >/dev/null \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

CMD ["bash"]

ARG BASE_IMAGE=localhost/event-led-pose/openeb-runtime:5.3.0-r3-ubuntu24
FROM ${BASE_IMAGE}

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ninja-build \
        usbutils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

CMD ["bash"]
